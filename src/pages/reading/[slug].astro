---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/Badge.astro';

export async function getStaticPaths() {
  const books = await getCollection('books');
  return books.map((book) => ({
    params: { slug: book.id },
    props: { book },
  }));
}

const { book } = Astro.props;
const { Content } = await render(book);
const dateLabel = book.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={book.data.title} description={book.data.summary}>
  <article class="prose-wrap prose book-article">
    <div class="book-cover">
      <Image
        src={book.data.cover}
        alt={`Cover of ${book.data.title}`}
        width={320}
        height={480}
        transition:name={`cover-${book.id}`}
      />
    </div>
    <div class="book-meta">
      <p class="eyebrow">{dateLabel}</p>
      {book.data.status === 'in-progress' && <Badge>In Progress</Badge>}
      <h1>{book.data.title}</h1>
      <p class="book-summary">{book.data.summary}</p>
    </div>
    <div class="book-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .book-article {
    padding-block: var(--space-6) var(--space-8);
  }

  .book-cover {
    width: 200px;
    max-width: 100%;
    margin: 0 auto var(--space-5);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .book-cover :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .book-meta {
    text-align: center;
  }

  .book-summary {
    color: var(--color-text-muted);
  }
</style>
