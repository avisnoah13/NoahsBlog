---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Badge from './Badge.astro';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const dateLabel = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<li class="post-card">
  <a href={`/projects/${post.id}/`} class="post-card-link">
    {
      post.data.heroImage && (
        <div class="post-card-image">
          <Image
            src={post.data.heroImage}
            alt=""
            width={560}
            height={420}
            transition:name={`hero-${post.id}`}
          />
        </div>
      )
    }
    <div class="post-card-body">
      {post.data.sponsor && <Badge variant="muted">Sponsored</Badge>}
      <p class="eyebrow">{dateLabel}</p>
      <h3>{post.data.title}</h3>
      <p class="post-card-summary">{post.data.summary}</p>
    </div>
  </a>
</li>

<style>
  .post-card {
    list-style: none;
  }

  .post-card-link {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .post-card-link:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }

  .post-card-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-border);
  }

  .post-card-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .post-card-link:hover .post-card-image :global(img) {
    transform: scale(1.04);
  }

  .post-card-body {
    padding: var(--space-4);
  }

  .post-card-body h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-lg);
  }

  .post-card-summary {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
